WANDB_API_KEY=
WANDB_PROJECT=your-project
WANDB_ENTITY=your-entity
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
TYPESAFE_API_KEY=
COREWEAVE_ENDPOINT=

# --- speech subsystem (all optional; models download on first use) ---
# WHISPER_MODEL=base            # base (~150 MB) ... large-v3 (~3 GB) or a CTranslate2 path
# SPEECH_ENCODER=microsoft/wavlm-base-plus   # ~380 MB; facebook/wav2vec2-base fallback
# TEXT_ENCODER=roberta-base     # own text path (~500 MB)
# NEUROINTENT_TEXT_MODEL=roberta-large       # vendored path (1.4 GB); roberta-base to start
# ECHOLOOP_NEUROINTENT=1        # 0 = skip the vendored NeuroIntent path
# ECHOLOOP_SPEECH=1             # 0 = typed / browser speech only
# ECHOLOOP_SPEECH_ENCODER=1   # WavLM utterance embedding (adds ~1.5 s per utterance on CPU)
# WHISPER_BEAM=1
